public class Fecha {
    private int mes;
    private int dia;
    private int anio;

    public Fecha(int mes, int dia, int anio) {
        this.mes = mes;
        this.dia = dia;
        this.anio = anio;
    }

    public void setMes(int mes) {
        this.mes = mes;
    }

    public void setDia(int dia) {
        this.dia = dia;
    }

    public void setAnio(int anio) {
        this.anio = anio;
    }

    public int getMes() {
        return mes;
    }

    public int getDia() {
        return dia;
    }

    public int getAnio() {
        return anio;
    }

    public void mostrarFecha() {
        System.out.println(mes + "/" + dia + "/" + anio);
    }
}

public class PruebaFecha {
    public static void main(String[] args) {

        Fecha fecha1 = new Fecha(4, 26, 2026);

        fecha1.mostrarFecha();

        fecha1.setMes(12);
        fecha1.setDia(25);
        fecha1.setAnio(2025);

        fecha1.mostrarFecha();
    }
}
